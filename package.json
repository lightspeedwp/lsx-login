{
  "name": "lsx-login",
  "version": "1.1.3",
  "description": "The LSX Login extension allows users to log into a dashboard and then see configurable content based on which users can access which content.",
  "scripts": {
    "build": "gulp build",
    "build:css": "gulp compile-css",
    "build:js": "gulp compile-js",
    "build:pot": "gulp wordpress-pot",
    "build:po": "gulp wordpress-po",
    "build:mo": "wp i18n make-mo languages",
    "build:lang": "npm run build:pot && npm run build:po && npm run build:mo",
    "watch": "gulp watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightspeedwp/lsx-login.git"
  },
  "keywords": [
    "lsx",
    "addon"
  ],
  "author": "LightSpeed",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/lightspeedwp/lsx-login/issues"
  },
  "homepage": "https://github.com/lightspeedwp/lsx-login#readme",
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "gulp": "^5.0.1",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-rtlcss": "^2.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-sort": "^2.0.0",
    "gulp-terser": "^2.1.0",
    "gulp-wp-pot": "^2.5.0",
    "sass": "^1.104.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
